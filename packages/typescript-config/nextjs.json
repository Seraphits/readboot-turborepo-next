{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/ui": ["../../packages/ui/src/index.tsx"],
      "@repo/ui/atoms": ["../../packages/ui/src/patterns/Atoms/index.tsx"],
      "@repo/ui/molecules": ["../../packages/ui/src/patterns/Molecules/index.tsx"],
      "@repo/ui/organisms": ["../../packages/ui/src/patterns/Organisms/index.tsx"],
      "@repo/ui/templates": ["../../packages/ui/src/patterns/Templates/index.tsx"],
      "@repo/ui/patterns/*": ["../../packages/ui/src/patterns/*"],
      "@repo/ui/styles/globals": ["../../packages/ui/src/styles/index.scss"],
      "@repo/ui/styles/index": ["../../packages/ui/src/styles/index.scss"],
      "@repo/ui/styles/*": ["../../packages/ui/src/styles/*"],
      "@repo/wp-utils": ["../../packages/wp-utils/src/index.ts"]
    }
  }
}
