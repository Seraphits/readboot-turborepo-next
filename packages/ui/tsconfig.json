{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@repo/wp-utils": ["../wp-utils/src/index.ts"],
      "@repo/ui": ["./src/index.tsx"],
      "@repo/ui/atoms": ["./src/patterns/Atoms/index.tsx"],
      "@repo/ui/molecules": ["./src/patterns/Molecules/index.tsx"],
      "@repo/ui/organisms": ["./src/patterns/Organisms/index.tsx"],
      "@repo/ui/templates": ["./src/patterns/Templates/index.tsx"],
      "@repo/ui/patterns/*": ["./src/patterns/*"]
    }
  },
  "include": ["src", "src/styles.d.ts"],
  "exclude": ["node_modules", "dist"]
}
