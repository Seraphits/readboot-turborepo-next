{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@repo/ui/framework": ["../../packages/ui/src/Framework/framework.scss"],
      "@repo/ui/sites": ["../../packages/ui/src/Framework/sites/index.ts"],
      "@repo/wp-utils": ["../../packages/wp-utils/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "next-env.d.ts",
    "next.config.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
