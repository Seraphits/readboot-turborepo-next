# Production: set to your canonical public URL (e.g. https://readboot.com or https://www.readboot.com).
NEXT_PUBLIC_SITE_URL=

# Same headless WordPress GraphQL endpoint as other apps (Vercel / local).
NEXT_PUBLIC_WORDPRESS_API_URL=

# On-demand revalidation (POST /api/revalidate/?secret=...)
REVALIDATE_SECRET=
