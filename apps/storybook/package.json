{
  "name": "storybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "rm -rf node_modules/.cache/storybook node_modules/.vite",
    "dev": "storybook dev -p 6006 --host localhost",
    "dev:clean": "rm -rf node_modules/.cache storybook-static .turbo && storybook dev -p 6006 --host localhost",
    "build": "storybook build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
